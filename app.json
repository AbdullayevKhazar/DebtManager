{
  "expo": {
    "name": "Borc İdarəsi",
    "slug": "starter-kit-expo-uniwind",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "borcvehesabat",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.xazar2211.borcvehesabat"
    },

    "web": {
      "bundler": "metro",
      "output": "static"
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "2521ab2a-a581-4119-8051-fd65107e2d03"
      }
    }
  }
}
